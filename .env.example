# Токен бота-лаунчера от @BotFather
BOT_TOKEN=

# Адрес, по которому Telegram открывает мини-апп. Обязательно https.
# На Amvera — домен приложения, например https://nebula.automatorr192.amvera.io/
WEBAPP_URL=https://automatorr192-dev.github.io/nebula-shop/

# Метка версии в адресе мини-аппа: меняй при каждой выкладке, иначе люди останутся
# на старой сборке — WebView Telegram кэширует её намертво. Пусто = текущее время.
WEBAPP_VERSION=
